# Copy this file to config.env. Never commit config.env.

# Mac address reachable from the phone, and the phone's private address.
DIALAGENT_BIND_IP=192.168.50.10
DIALAGENT_PHONE_IP=192.168.50.20

# Yealink HTTPS identity. Get these from your own phone; do not reuse examples.
DIALAGENT_PHONE_DEVICE_NAME=001565abcdef
DIALAGENT_PHONE_CERT_SHA256=REPLACE_WITH_64_HEX_CHARACTERS

# Optional existing Codex task UUID. Leave empty to use the visible task.
DIALAGENT_VOICE_THREAD_ID=

DIALAGENT_SIP_PORT=5060
DIALAGENT_RTP_PORT=24200
DIALAGENT_ACTION_PORT=8765
DIALAGENT_RUNTIME_SECONDS=600
DIALAGENT_WEEK_REMAINING=42
